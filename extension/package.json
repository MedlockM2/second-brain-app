{
  "name": "@media-summarizer/extension",
  "version": "1.0.0",
  "private": true,
  "description": "Deepn browser extension: save a page or selection on Chrome, Edge and Firefox.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "python3 scripts/package_release.py --purpose distribution --target chromium",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint entrypoints lib wxt.config.ts --ext .ts",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip:firefox": "python3 scripts/package_release.py --purpose distribution --target firefox",
    "sources:firefox": "python3 scripts/firefox_sources.py",
    "package:ci": "python3 scripts/package_release.py --purpose validation --target all"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "typescript": "~5.9.2",
    "wxt": "~0.20.27"
  }
}
