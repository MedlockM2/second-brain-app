# Build-time configuration of the extension. Copy to .env.local (git-ignored).
# Both are public: they end up in the manifest and the bundle.

# The API. Until api.<domain> exists, the -dev execute-api URL.
VITE_API_BASE_URL=

# The web app's origin, the only page allowed to hand the extension its token
# (externally_connectable). https://app.<domain>; http://localhost:5173 in development.
VITE_WEB_APP_ORIGIN=
