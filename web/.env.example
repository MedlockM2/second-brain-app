# Build-time configuration of the web app. Vite inlines every VITE_* variable
# into the bundle: they are public by construction, never put a secret here.
# Local development: copy to .env.local. Distribution: .env.<mode>.local
# (git-ignored); see docs/WEB_RELEASE.md. Builds validate these public settings.
# Missing optional values keep the explicit fallback described in that runbook.

# Local Vite: the dev execute-api URL (Terraform output api_endpoint).
# Hosted web: app_base_url from the same Terraform root. CloudFront forwards
# /api/* to the API, keeping the session cookie on the web app's own origin.
# Do not append /api: the client supplies that prefix.
VITE_API_BASE_URL=

# The chat's streaming door, a separate API: `terraform output -raw chat_stream_url`
# in infrastructure/terraform/envs/dev (it ends in /v1). Its CORS allows the same
# web_app_origin as the API (task-474). Empty: answers appear when they are done,
# by re-reading the conversation.
VITE_CHAT_STREAM_URL=

# Cognito provider/client configuration is obtained from /api/auth/oauth/config.
# No Google or Apple SDK configuration belongs in the web bundle.

# Installation links under 900 px: TestFlight/Apps Store for iOS and Play
# opt-in/store listing for Android. Empty links are disabled, not invented.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# The public site, https://www.<domain> (task-445): My account links to its
# /extension install page. Empty until the domain exists.
VITE_SITE_URL=

# The feedback board, opened directly when GET /api/feedback/token is
# unavailable (the same board as the mobile EXPO_PUBLIC_FEEDBACK_URL).
VITE_FEEDBACK_URL=

# The browser extension's ids, comma-separated: its Chrome Web Store id and its
# Edge Add-ons id (one package, one id per store; an unpacked build has its own).
# Pairing tries IDs in order until one confirms; empty leaves the rescue code.
VITE_EXTENSION_IDS=

# Sentry's DSN (task-604): the direct upload to S3 is traced as op `upload.s3`
# (mobile/MOBILE_CI_CD.md, "Crash Reporting (Sentry)"). Public by design; empty
# reports nothing.
VITE_SENTRY_DSN=
