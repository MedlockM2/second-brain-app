  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~5.9.2",
    "vite": "^6.4.0"
  }
