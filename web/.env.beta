# Public configuration of the dev web app on CloudFront (TASK-605), built by
# .github/workflows/deploy-web.yml on every push to main (TASK-608). Every value
# ends up in the JavaScript and in release.json: public values only, never a
# secret. Sources: `terraform output` in infrastructure/terraform/envs/dev.
# Rules and the meaning of an empty value: docs/WEB_RELEASE.md.

# app_base_url: CloudFront forwards /api/* to the dev API (same-origin cookie).
VITE_API_BASE_URL=https://d3n3qjz3si2rme.cloudfront.net
# chat_stream_url
VITE_CHAT_STREAM_URL=https://evh853pvbl.execute-api.eu-west-3.amazonaws.com/v1
# Not available yet; empty keeps the documented fallbacks.
VITE_SITE_URL=
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
VITE_FEEDBACK_URL=
VITE_EXTENSION_IDS=bpmelnjdcceddagpmpkgkhhlbmapijka
